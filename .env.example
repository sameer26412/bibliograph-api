APP_ENV=development
DATABASE_URL=sqlite:///./bibliograph_local.db
SECRET_KEY=replace-with-a-32-byte-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=5000
OUTBOUND_TIMEOUT_SECONDS=3.5
MAX_REQUEST_BODY_BYTES=65536
RATE_LIMIT_DEFAULT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10
SEED_DEMO_DATA=true
SEED_LIBRARIAN_EMAIL=librarian@bibliograph.dev
SEED_LIBRARIAN_PASSWORD=ChangeMeLocal123!